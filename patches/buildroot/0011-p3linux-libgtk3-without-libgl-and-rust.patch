diff --git a/package/libepoxy/libepoxy.mk b/package/libepoxy/libepoxy.mk
index 16304288..e71f63f7 100644
--- a/package/libepoxy/libepoxy.mk
+++ b/package/libepoxy/libepoxy.mk
@@ -24,6 +24,10 @@ endif
 ifeq ($(BR2_PACKAGE_HAS_LIBGL)$(BR2_PACKAGE_XLIB_LIBX11),yy)
 LIBEPOXY_CONF_OPTS += -Dglx=yes -Dx11=true
 LIBEPOXY_DEPENDENCIES += libgl xlib_libX11
+else ifeq ($(BR2_PACKAGE_XLIB_LIBX11),y)
+# GLX dispatch without a build-time libGL (libGL is dlopen()ed at runtime)
+LIBEPOXY_CONF_OPTS += -Dglx=yes -Dx11=true
+LIBEPOXY_DEPENDENCIES += xlib_libX11
 else
 LIBEPOXY_CONF_OPTS += -Dglx=no -Dx11=false
 endif
