# ---- P3 Linux kernel fragment (applied on top of i386_defconfig) ----
# CPU: Pentium III, no PAE (works on all P3 incl. mobile), up to 4GB HIGHMEM
CONFIG_X86_32=y
# CONFIG_64BIT is not set
CONFIG_MPENTIUMIII=y
# CONFIG_M686 is not set
CONFIG_HIGHMEM4G=y
# CONFIG_HIGHMEM64G is not set
# CONFIG_X86_PAE is not set
CONFIG_NOHIGHMEM=n
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_X86_GENERIC=n
CONFIG_MATH_EMULATION=n
CONFIG_ACPI=y
CONFIG_APM=y
CONFIG_X86_MCE=n
CONFIG_KVM_GUEST=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ---- Storage: IDE/PATA, ATAPI CD-ROM, SATA (AHCI) for later boards ----
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_PATA_AMD=y
CONFIG_PATA_VIA=y
CONFIG_PATA_SIS=y
CONFIG_PATA_ALI=y
CONFIG_PATA_SERVERWORKS=y
CONFIG_PATA_HPT366=y
CONFIG_PATA_PDC2027X=y
CONFIG_PATA_PDC_OLD=y
CONFIG_PATA_CMD64X=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_MPIIX=y
CONFIG_PATA_LEGACY=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_ACPI=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_BLK_DEV_LOOP=y
# ---- Filesystems ----
CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_932=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
# ---- Display: VGA console, VESA framebuffer, QEMU bochs ----
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_VGA16=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_SYSFB_SIMPLEFB=n
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_AGP_VIA=y
CONFIG_AGP_AMD=y
CONFIG_AGP_SIS=y
CONFIG_AGP_ALI=y
# ---- Input: PS/2 keyboard and mouse, USB HID ----
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID=y
CONFIG_USB_HID=y
# ---- Serial console (for automated tests) ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# ---- Network: common P3-era NICs ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E100=y
CONFIG_E1000=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_3COM=y
CONFIG_VORTEX=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=y
CONFIG_NET_VENDOR_DEC=y
CONFIG_NET_TULIP=y
CONFIG_TULIP=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2K_PCI=y
CONFIG_NET_VENDOR_SIS=y
CONFIG_SIS900=y
# ---- Sound off (save RAM) ----
CONFIG_SOUND=n
# ---- Trim ----
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_NETFILTER=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_KERNEL=n
CONFIG_KALLSYMS_ALL=n
# ---- Low-memory (64MB) trimming: features P3 Linux does not use ----
CONFIG_AUDIT=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_SECURITY=n
CONFIG_SECURITY_SELINUX=n
CONFIG_EFI=n
CONFIG_HIBERNATION=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_IP_MULTICAST=n
CONFIG_IPV6=n
CONFIG_NET_SCHED=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_NFS_FS=n
CONFIG_MD=n
CONFIG_BLK_DEV_DM=n
CONFIG_MACINTOSH_DRIVERS=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_MISC=n
CONFIG_DRM_I915=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_USB_XHCI_HCD=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_PCCARD=n
CONFIG_HID_A4TECH=n
CONFIG_HID_APPLE=n
CONFIG_HID_BELKIN=n
CONFIG_HID_CHERRY=n
CONFIG_HID_CHICONY=n
CONFIG_HID_CYPRESS=n
CONFIG_HID_EZKEY=n
CONFIG_HID_GYRATION=n
CONFIG_HID_ITE=n
CONFIG_HID_KENSINGTON=n
CONFIG_HID_LOGITECH=n
CONFIG_HID_REDRAGON=n
CONFIG_HID_MICROSOFT=n
CONFIG_HID_MONTEREY=n
CONFIG_HID_NTRIG=n
CONFIG_HID_PANTHERLORD=n
CONFIG_HID_PETALYNX=n
CONFIG_HID_SAMSUNG=n
CONFIG_HID_SONY=n
CONFIG_HID_SUNPLUS=n
CONFIG_HID_TOPSEED=n
CONFIG_HID_PID=n
CONFIG_KALLSYMS=n
CONFIG_BUG_ON_DATA_CORRUPTION=n
CONFIG_SCHED_DEBUG=n
CONFIG_DEBUG_FS=n
CONFIG_STACKTRACE=n
CONFIG_PERF_EVENTS=n
CONFIG_BPF_SYSCALL=n
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_LOGO=n
CONFIG_X86_X2APIC=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_RELOCATABLE=n
CONFIG_NR_CPUS=2
# ---- Low-memory safety net: compressed swap in RAM (enabled at boot when RAM < 100MB) ----
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_CRYPTO_LZO=y
# drivers for hardware that did not exist in the Pentium III era
CONFIG_BNX2=n
CONFIG_TIGON3=n
CONFIG_E1000E=n
CONFIG_SKY2=n
CONFIG_FORCEDETH=n
CONFIG_NETCONSOLE=n
CONFIG_USB_NET_DRIVERS=n
CONFIG_VIRTIO_MENU=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_CONSOLE=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VIRTIO_PCI=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_HW_RANDOM_VIRTIO=n
