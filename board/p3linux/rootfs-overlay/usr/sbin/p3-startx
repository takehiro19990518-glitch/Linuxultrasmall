#!/bin/sh
# P3 Linux: start X.Org + desktop on tty1 (respawned by init).
#
# Video driver selection: X.Org's own autodetection fails on several cards of
# the era (e.g. ATI chips want the "ati" wrapper driver, which is not built),
# so we pick candidates from the PCI vendor ID of the VGA card and fall back
# to the next one if X does not come up:
#     KMS (modesetting) -> card specific driver(s) -> X autodetect -> vesa -> fbdev
# The driver that worked is remembered in /etc/X11/p3-driver.
# Kernel parameters: p3.xdriver=<name> forces a driver, p3.depth=8|16|24,
# p3.res=WxH, nox (text mode only).
export HOME=/root USER=root DISPLAY=:0 PATH=/usr/bin:/usr/sbin:/bin:/sbin
LOG=/var/log/p3-session.log
CONF=/etc/X11/xorg.conf.d
if grep -qw nox /proc/cmdline; then exec /sbin/getty 38400 tty1; fi

MEM=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
if [ "$MEM" -lt 100 ]; then MODES='"800x600" "640x480"'; else MODES='"1024x768" "800x600" "640x480"'; fi
FORCE_DEPTH= ; FORCE_DRV=
for a in $(cat /proc/cmdline); do
  case $a in
    p3.depth=*) FORCE_DEPTH=${a#p3.depth=};;
    p3.res=*) MODES="\"${a#p3.res=}\" \"640x480\"";;
    p3.xdriver=*) FORCE_DRV=${a#p3.xdriver=};;
  esac
done
FIRST=$(echo "$MODES" | cut -d'"' -f2)
VIRT="${FIRST%x*} ${FIRST#*x}"

# PCI vendor of the (first) VGA-compatible display controller
VENDOR=
for d in /sys/bus/pci/devices/*; do
  case $(cat $d/class 2>/dev/null) in 0x0300*) VENDOR=$(cat $d/vendor); break;; esac
done
case $VENDOR in
  0x1002) CARD="r128 mach64";;   # ATI (Radeon uses KMS + modesetting)
  0x102b) CARD="mga";;           # Matrox
  0x5333) CARD="savage";;        # S3 Savage
  0x121a) CARD="tdfx";;          # 3dfx Voodoo3/4/5, Banshee
  0x10c8) CARD="neomagic";;      # NeoMagic (laptops)
  0x126f) CARD="siliconmotion";; # Silicon Motion (laptops)
  0x1013) CARD="cirrus";;        # Cirrus Logic
  *) CARD=;;                     # nVidia, SiS, Trident, VIA, Intel 810: vesa
esac
if [ -n "$FORCE_DRV" ]; then
  CANDIDATES=$FORCE_DRV
else
  CANDIDATES=
  [ -f /etc/X11/p3-driver ] && CANDIDATES=$(cat /etc/X11/p3-driver)
  [ -e /dev/dri/card0 ] && CANDIDATES="$CANDIDATES modesetting"
  CANDIDATES="$CANDIDATES $CARD auto vesa fbdev"
fi

start_x() {   # $1 = driver ("auto" = no Device section)
  drv=$1
  # KMS drivers usually need 24/32bpp; VESA/fbdev/old cards: 16bpp saves memory
  if [ -n "$FORCE_DEPTH" ]; then DEPTH=$FORCE_DEPTH
  elif [ "$drv" = modesetting ] || { [ "$drv" = auto ] && [ -e /dev/dri/card0 ]; }; then DEPTH=24
  else DEPTH=16; fi
  mkdir -p $CONF
  if [ "$drv" = auto ]; then
    rm -f $CONF/10-p3-device.conf; DEVLINE=
  else
    printf 'Section "Device"\n    Identifier "Card0"\n    Driver "%s"\nEndSection\n' "$drv" > $CONF/10-p3-device.conf
    DEVLINE='    Device "Card0"'
  fi
  # fbdev can only use the mode the kernel framebuffer is already in
  if [ "$drv" = fbdev ]; then MODELINES=; else MODELINES="        Modes $MODES
        Virtual $VIRT"; fi
  # Without EDID (old monitors, KVMs) drivers need sync ranges to accept any
  # mode: these are safe for 15"/17" CRTs of the era (1024x768 @ 60-70Hz).
  if [ "$drv" = modesetting ] || { [ "$drv" = auto ] && [ -e /dev/dri/card0 ]; }; then
    MON=; MONLINE=
  else
    MON='Section "Monitor"
    Identifier "Monitor0"
    HorizSync 31.5-57.0
    VertRefresh 50-75
EndSection'
    MONLINE='    Monitor "Monitor0"'
  fi
  cat > $CONF/20-p3-modes.conf <<EOC
# generated by p3-startx (RAM ${MEM}MB, driver $drv)
$MON
Section "Screen"
    Identifier "Screen0"
$DEVLINE
$MONLINE
    DefaultDepth $DEPTH
    SubSection "Display"
        Depth $DEPTH
$MODELINES
    EndSubSection
EndSection
EOC
  rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
  echo "p3-startx: starting Xorg (driver $drv, depth $DEPTH)" > /dev/console
  /usr/bin/Xorg :0 vt1 -depth "$DEPTH" -nolisten tcp -noreset >$LOG 2>&1 &
  XPID=$!
  i=0
  while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 150 ]; do
    kill -0 $XPID 2>/dev/null || return 1
    sleep 0.2; i=$((i+1))
  done
  [ -S /tmp/.X11-unix/X0 ] || { kill $XPID 2>/dev/null; return 1; }
  sleep 2                                   # must survive screen setup
  kill -0 $XPID 2>/dev/null || return 1
  return 0
}

for drv in $CANDIDATES; do
  if start_x "$drv"; then
    echo "$drv" > /etc/X11/p3-driver
    echo "P3LINUX: X STARTED (driver $drv)" > /dev/console
    /usr/bin/p3-session >>$LOG 2>&1
    kill $XPID 2>/dev/null
    wait $XPID
    exit 0
  fi
  cp /var/log/Xorg.0.log "/var/log/Xorg.failed-$drv.log" 2>/dev/null
  echo "p3-startx: driver $drv failed" > /dev/console
done
echo "P3LINUX: X FAILED (see /var/log/Xorg.failed-*.log)" > /dev/console
rm -f /etc/X11/p3-driver
sleep 5
exec /sbin/getty 38400 tty1
