#!/bin/sh
# P3 Linux: start X.Org + desktop on tty1 (respawned by init).
export HOME=/root USER=root DISPLAY=:0 PATH=/usr/bin:/usr/sbin:/bin:/sbin
LOG=/var/log/p3-session.log
# "nox" on the kernel command line: text mode only
if grep -qw nox /proc/cmdline; then exec /sbin/getty 38400 tty1; fi
# KMS drivers (modesetting) usually need 24/32bpp; VESA/fbdev on old cards
# run at 16bpp to save video and system memory.
if [ -e /dev/dri/card0 ]; then DEPTH=24; else DEPTH=16; fi
# Screen modes: Pentium III-era monitors (max 1024x768); 800x600 on <100MB RAM.
MEM=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
if [ "$MEM" -lt 100 ]; then MODES='"800x600" "640x480"'; else MODES='"1024x768" "800x600" "640x480"'; fi
for a in $(cat /proc/cmdline); do
  case $a in
    p3.depth=*) DEPTH=${a#p3.depth=};;
    p3.res=*) MODES="\"${a#p3.res=}\" \"640x480\"";;
  esac
done
# Virtual = first (largest) mode, otherwise the vesa driver sizes the screen
# to the biggest VBE mode the card offers (e.g. 1920x1080 on a 1999 CRT).
FIRST=$(echo "$MODES" | cut -d'"' -f2)
VIRT="${FIRST%x*} ${FIRST#*x}"
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/20-p3-modes.conf <<EOC
# generated by p3-startx (RAM ${MEM}MB)
Section "Screen"
    Identifier "Screen0"
    SubSection "Display"
        Depth $DEPTH
        Modes $MODES
        Virtual $VIRT
    EndSubSection
EndSection
EOC
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
echo "p3-startx: starting Xorg (depth $DEPTH)" > /dev/console
/usr/bin/Xorg :0 vt1 -depth "$DEPTH" -nolisten tcp -noreset >$LOG 2>&1 &
XPID=$!
i=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 150 ]; do
  kill -0 $XPID 2>/dev/null || break
  sleep 0.2; i=$((i+1))
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
  echo "P3LINUX: X FAILED (see /var/log/Xorg.0.log)" > /dev/console
  sleep 5; exec /sbin/getty 38400 tty1
fi
echo "P3LINUX: X STARTED" > /dev/console
/usr/bin/p3-session >>$LOG 2>&1
kill $XPID 2>/dev/null
wait $XPID
