#!/bin/sh
# P3 Linux: open a file with a suitable application (used by the file manager).
f="$1"
[ -n "$f" ] || exit 1
if [ -d "$f" ]; then exec p3-files "$f"; fi
lc=$(echo "$f" | tr 'A-Z' 'a-z')
view() { exec xterm -T "$(basename "$f")" -e sh -c "$1 | less"; }
# AbiWord / Gnumeric (GTK3) need about 128MB; smaller PCs get the light viewers
mem=$(awk '/^MemTotal/ {print int($2/1024)}' /proc/meminfo)
if [ "${mem:-0}" -ge 110 ] && command -v abiword >/dev/null; then
  case "$lc" in
    *.doc|*.docx|*.rtf|*.odt|*.abw|*.wri) exec abiword "$f";;
    *.xls|*.xlsx|*.ods|*.csv|*.gnumeric) exec gnumeric "$f";;
  esac
fi
case "$lc" in
  *.pdf|*.xps|*.epub|*.cbz) exec mupdf-x11 "$f";;
  *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.tif|*.tiff|*.pnm|*.ppm|*.xpm) exec feh -. -g 640x480 "$f";;
  *.htm|*.html) command -v netsurf-gtk3 >/dev/null && [ "${mem:-0}" -ge 90 ] && exec netsurf-gtk3 "file://$(realpath "$f")"; exec dillo "$f";;
  *.mp3|*.mp2) exec xterm -T "Music: $(basename "$f")" -e mpg123 -v "$f";;
  *.wav|*.ogg|*.flac|*.au|*.aiff|*.voc) exec xterm -T "Music: $(basename "$f")" -e play "$f";;
  *.doc) view "antiword \"$f\"";;
  *.xls) view "xls2csv \"$f\"";;
  *.ppt) view "catppt \"$f\"";;
  *.rtf) view "catdoc \"$f\"";;
  *.csv|*.xlsx|*.sc) exec xterm -T "Spreadsheet" -e sc-im "$f";;
  *.zip|*.7z|*.tar|*.tgz|*.gz|*.bz2|*.xz|*.rar) view "7za l \"$f\"";;
  *.wad) exec chocolate-doom -iwad "$f";;
  *) if file -b "$f" 2>/dev/null | grep -qiE 'text|empty'; then exec p3-edit "$f"; fi
     exec xterm -T "$(basename "$f")" -e sh -c "file \"$f\"; echo; hexdump -C \"$f\" | less";;
esac
