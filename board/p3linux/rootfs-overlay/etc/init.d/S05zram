#!/bin/sh
# P3 Linux low-memory support: on machines with less than 100MB of RAM,
# add compressed swap in RAM (zram, LZO - cheap enough for a Pentium III).
# Kernel parameter "p3.zram=0" disables it, "p3.zram=1" forces it.
case "$1" in
  start)
    mem=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
    want=0; [ "$mem" -lt 100 ] && want=1
    for a in $(cat /proc/cmdline); do case $a in p3.zram=*) want=${a#p3.zram=};; esac; done
    [ "$want" = 1 ] || exit 0
    [ -e /sys/block/zram0 ] || exit 0
    size=$(( mem / 2 ))
    echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null
    echo "${size}M" > /sys/block/zram0/disksize && mkswap /dev/zram0 >/dev/null && swapon /dev/zram0 \
      && echo "Low memory (${mem}MB): enabled ${size}MB compressed swap (zram)"
    echo 60 > /proc/sys/vm/swappiness
    ;;
  stop)
    swapoff /dev/zram0 2>/dev/null
    ;;
esac
exit 0
