# ---- Target: Intel Pentium III (i686 + SSE, no SSE2) ----
BR2_x86_pentium3=y
BR2_OPTIMIZE_S=y
# ---- Toolchain: Buildroot internal, musl libc ----
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# ---- System ----
BR2_TARGET_GENERIC_HOSTNAME="p3linux"
BR2_TARGET_GENERIC_ISSUE="Welcome to P3 Linux"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="p3linux"
BR2_SYSTEM_DHCP="eth0"

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_P3LINUX_PATH)/board/p3linux/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_P3LINUX_PATH)/board/p3linux/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_P3LINUX_PATH)/board/p3linux/post-image.sh"
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
# ---- Kernel: Linux 6.12 LTS ----
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://gitlab.com/linux-kernel/stable.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v6.12.111"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_P3LINUX_PATH)/board/p3linux/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
# ---- Base userland ----
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_P3LINUX_PATH)/board/p3linux/busybox.fragment"
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# ---- X.Org ----
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_VESA=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XAPP_XKBCOMP=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_FONTCONFIG=y
# ---- Window manager + desktop ----
BR2_PACKAGE_FLUXBOX=y
BR2_PACKAGE_FLTK=y
BR2_PACKAGE_P3_DESKTOP=y
# ---- Bootloader / images ----
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="160M"
# BR2_TARGET_ROOTFS_TAR is not set
